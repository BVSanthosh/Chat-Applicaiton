# Copy to `.dev.vars` for local `wrangler dev`. Never commit `.dev.vars`.
# In production set these with: npx wrangler secret put <NAME>

# Required. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Relaxes the cookie `Secure` flag so the session works over plain http locally.
APP_ENV="development"

# Optional. Omit all three to disable image uploads (the API then returns a
# clear 503 for upload attempts instead of failing in a confusing way).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
